{
  "name": "punchlines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node --test tests/api.integration.mjs",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "admin:create": "node scripts/create-admin.mjs",
    "db:migrate:local": "wrangler d1 migrations apply words --local",
    "db:migrate:remote": "wrangler d1 migrations apply words --remote"
  },
  "dependencies": {
    "hono": "4.13.13",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.46.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "wrangler": "4.113.0"
  },
  "overrides": {
    "undici": "7.30.0",
    "sharp": "0.35.5"
  }
}
